---
import HeaderLink from './HeaderLink.astro';
import { clsx } from 'clsx';
import { SITE_TITLE } from '../consts';

const socialLinks = [
  {
    url: 'https://m.webtoo.ls/@astro',
    label: 'Follow Astro on Mastodon',
    type: 'mastodon',
  },
  {
    url: 'https://twitter.com/astrodotbuild',
    label: 'Follow Astro on Twitter',
    type: 'twitter',
  },
  {
    url: 'github.com/withastro/astro',
    label: "Go to Astro's GitHub repo",
    type: 'github',
  },
];
---

<header class="bg-white shadow-xs">
  <nav class="flex items-center justify-between p-4">
    <h2><a href="/">{SITE_TITLE}</a></h2>
    <div>
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/blog">Blog</HeaderLink>
    </div>
    <div class="flex gap-4">
      {
        socialLinks.map((link) => (
          <a
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.label}
            class="flex items-center justify-center hover:bg-gray-400/35 p-2 rounded-full hover:animate-wiggle hover:animate-infinite cursor-pointer transition-colors"
          >
            <span class="sr-only">{link.label}</span>
            <span
              class={clsx('flex size-6', {
                'icon-[tabler--brand-mastodon]': link.type === 'mastodon',
                'icon-[tabler--brand-x]': link.type === 'twitter',
                'icon-[tabler--brand-github]': link.type === 'github',
              })}
            />
          </a>
        ))
      }
    </div>
  </nav>
</header>
